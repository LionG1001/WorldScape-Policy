# One node per row; row order assigns NODE_RANK. Equal slots required.
node0 slots=8
node1 slots=8
# Optional fields: user=USER port=22 hca==mlx5_0:1,mlx5_1:1
# hca== preserves the leading = used by MCCL for exact adapter matching.
# Defaults: SSH_USER (otherwise SSH config/current user), SSH_PORT=22,
# MCCL_IB_HCA (otherwise MCCL automatic adapter selection).
